<Window x:Class="DocConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF转换器" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Icon="pack://application:,,,/Assets/DocConvert.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Geometry x:Key="AddIcon">M12,5 V19 M5,12 H19</Geometry>
        <Geometry x:Key="FolderIcon">M3,6 H9 L11,8 H21 V19 H3 Z</Geometry>
        <Geometry x:Key="PlayIcon">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="BroomIcon">M5,18 L11,12 M9,6 L18,15 M12,3 L21,12 L17,16 L8,7 Z</Geometry>
        <Geometry x:Key="ChevronLeftIcon">M15,6 L9,12 L15,18</Geometry>
        <Geometry x:Key="ChevronRightIcon">M9,6 L15,12 L9,18</Geometry>
        <Geometry x:Key="TrashIcon">M6,7 H18 M9,7 V4 H15 V7 M8,10 V19 H16 V10</Geometry>
        <Geometry x:Key="SearchIcon">M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21</Geometry>
        <Geometry x:Key="SparkIcon">M12,3 L13.7,8.3 L19,10 L13.7,11.7 L12,17 L10.3,11.7 L5,10 L10.3,8.3 Z</Geometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PDF转换器" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="专业 PDF 转换、OCR 与授权文档去水印" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource SecondarySoftBrush}" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="本地处理" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,8,18,12">
            <TabItem Header="文件转换">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="142" />
                                    <ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding AddConversionFilesCommand}" Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddIcon}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="添加文件" /></StackPanel>
                                </Button>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding SelectedTargetFormat}" />
                                <TextBlock Grid.Column="4" Text="清晰度" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsPptOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ComboBox Grid.Column="5" ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding RenderDpi}" Visibility="{Binding IsPptOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <CheckBox Grid.Column="7" Content="启用 OCR" IsChecked="{Binding EnableOcr}" IsEnabled="{Binding IsOcrAvailable}" VerticalAlignment="Center" />
                                <Button Grid.Column="9" Command="{Binding ClearCompletedCommand}" ToolTip="清除已完成任务">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource BroomIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0" /><TextBlock Text="清理已完成" /></StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Background="#FAF5F2" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SparkIcon}" Fill="{StaticResource PrimaryBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,1,8,0" />
                                    <TextBlock Text="{Binding ConversionModeDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <DataGrid ItemsSource="{Binding ConversionJobs}" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="2.2*" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding FileType}" Width="78" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Message}" Width="1.5*" />
                                    <DataGridTemplateColumn Header="进度" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Progress}" Height="7" Margin="10,0" Foreground="{StaticResource SecondaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="输出" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="打开位置" Height="30" Padding="8,0" Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ConversionJobs.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="390">
                                    <Image Source="pack://application:,,,/Assets/conversion-empty.png" Width="230" Height="154" Stretch="Uniform" IsHitTestVisible="False" />
                                    <TextBlock Text="把文件拖到这里" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" IsHitTestVisible="False" />
                                    <TextBlock Text="支持 PDF、Office、图片与 TXT，转换任务可批量执行" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" IsHitTestVisible="False" />
                                    <Button Command="{Binding AddConversionFilesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddIcon}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="添加文件" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="输出目录" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding OutputFolder}" Margin="10,0,0,0" IsReadOnly="True" />
                        <Button Grid.Column="3" Command="{Binding ChooseOutputFolderCommand}" ToolTip="选择输出目录" Style="{StaticResource IconButton}"><Path Data="{StaticResource FolderIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" /></Button>
                        <Button Grid.Column="5" Command="{Binding StartConversionCommand}" Style="{StaticResource PrimaryButton}" MinWidth="122">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayIcon}" Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="开始转换" /></StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="去水印">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Button Margin="12" Command="{Binding AddWatermarkFilesCommand}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddIcon}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="添加待处理文件" /></StackPanel></Button>
                            <ListBox Grid.Row="1" ItemsSource="{Binding WatermarkFiles}" SelectedItem="{Binding SelectedWatermarkFile}" BorderThickness="0" Margin="6"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid x:Name="PreviewHost" Background="{StaticResource PreviewBrush}" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                            <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}" Stretch="Uniform" Margin="18" />
                            <Canvas x:Name="SelectionCanvas" Margin="18" IsHitTestVisible="False" SizeChanged="SelectionCanvas_SizeChanged" />
                            <TextBlock Text="选择图片或 PDF 后可在此框选水印" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Background="#F2FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding PreviousPreviewPageCommand}" ToolTip="上一页" Style="{StaticResource IconButton}" IsEnabled="{Binding HasPreviousPreviewPage}"><Path Data="{StaticResource ChevronLeftIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" /></Button>
                                    <TextBlock Text="{Binding PreviewPageText}" VerticalAlignment="Center" Margin="12,0" MinWidth="58" TextAlignment="Center" />
                                    <Button Command="{Binding NextPreviewPageCommand}" ToolTip="下一页" Style="{StaticResource IconButton}" IsEnabled="{Binding HasNextPreviewPage}"><Path Data="{StaticResource ChevronRightIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" /></Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="检测与选区" FontSize="16" FontWeight="SemiBold" />
                            <Button Command="{Binding DetectWatermarksCommand}" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="检测候选" /></StackPanel></Button>
                            <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Confidence}" Foreground="{StaticResource SecondaryBrush}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="手动选区" FontWeight="SemiBold" Margin="0,18,0,0" />
                            <TextBlock Text="在预览中拖动鼠标；自动候选只推荐，不会直接删除。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Regions.Count, StringFormat=已选 {0} 个区域}" VerticalAlignment="Center" /><Button Grid.Column="1" Command="{Binding ClearRegionsCommand}" ToolTip="清除选区" Style="{StaticResource IconButton}"><Path Data="{StaticResource TrashIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" /></Button></Grid>
                            <Separator Margin="0,16" />
                            <TextBlock Text="作用范围" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding WatermarkScopes}" SelectedItem="{Binding SelectedWatermarkScope}" DisplayMemberPath="Label" Margin="0,9,0,0" />
                            <TextBlock Text="页码范围，例如 1,3-5" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3" />
                            <TextBox Text="{Binding PageRange}" IsEnabled="{Binding IsPageRangeScope}" />
                            <Separator Margin="0,16" />
                            <TextBlock Text="仅处理您有权修改的文档。密码、DRM、权限限制和数字签名文件会被拒绝。" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <Button Command="{Binding RemoveWatermarkCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SparkIcon}" Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="生成无水印副本" /></StackPanel></Button>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0"><TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /><Button Content="取消" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Height="28" Padding="10,0" VerticalAlignment="Center" /></Grid>
        </Border>
    </Grid>
</Window>
