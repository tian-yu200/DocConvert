<UserControl x:Class="DocConvert.App.PdfEditorSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyDown="Surface_KeyDown">
    <UserControl.Resources>
        <Geometry x:Key="PdfEditorFileIcon">M6,2 H15 L20,7 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z M14,2 V7 H19</Geometry>
        <Geometry x:Key="PdfEditorChevronLeftIcon">M15,6 L9,12 L15,18</Geometry>
        <Geometry x:Key="PdfEditorChevronRightIcon">M9,6 L15,12 L9,18</Geometry>
        <Geometry x:Key="PdfEditorZoomInIcon">M11,4 V18 M4,11 H18</Geometry>
        <Geometry x:Key="PdfEditorZoomOutIcon">M4,11 H18</Geometry>
        <Geometry x:Key="PdfEditorFitIcon">M8,4 H4 V8 M16,4 H20 V8 M8,20 H4 V16 M16,20 H20 V16</Geometry>
    </UserControl.Resources>
    <Grid x:Name="SurfaceHost" Background="{StaticResource PreviewBrush}">
        <Canvas x:Name="ViewportCanvas"
                Background="Transparent"
                ClipToBounds="True"
                MouseDown="Surface_MouseDown"
                MouseMove="Surface_MouseMove"
                MouseUp="Surface_MouseUp"
                MouseWheel="Surface_MouseWheel"
                SizeChanged="Surface_SizeChanged">
            <Border x:Name="PageFrame" Background="White" BorderBrush="#26000000" BorderThickness="1" IsHitTestVisible="False">
                <Image x:Name="PageImage" Source="{Binding PdfEditorPreviewImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
        </Canvas>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PdfEditorPreviewImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="70" Height="70" CornerRadius="16" Background="White" Effect="{StaticResource CardShadow}">
                <Path Data="{StaticResource PdfEditorFileIcon}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                      Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
            </Border>
            <TextBlock Text="打开 PDF 后在页面上直接编辑" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Margin="0,15,0,0" />
        </StackPanel>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                Background="#F5FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="6,4" Effect="{StaticResource CardShadow}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PdfEditorPreviewImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding PreviousPdfEditorPageCommand}" ToolTip="上一页" Style="{StaticResource IconButton}"
                        IsEnabled="{Binding HasPreviousPdfEditorPage}" Height="30" Width="30">
                    <Path Data="{StaticResource PdfEditorChevronLeftIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                          Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <TextBlock Text="{Binding PdfEditorPageText}" VerticalAlignment="Center" Margin="10,0" MinWidth="60"
                           TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                <Button Command="{Binding NextPdfEditorPageCommand}" ToolTip="下一页" Style="{StaticResource IconButton}"
                        IsEnabled="{Binding HasNextPdfEditorPage}" Height="30" Width="30">
                    <Path Data="{StaticResource PdfEditorChevronRightIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                          Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="8,0" />
                <Button Click="ZoomOut_Click" ToolTip="缩小" Style="{StaticResource IconButton}" Height="30" Width="30">
                    <Path Data="{StaticResource PdfEditorZoomOutIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="8,0" MinWidth="45"
                           TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                <Button Click="ZoomIn_Click" ToolTip="放大" Style="{StaticResource IconButton}" Height="30" Width="30">
                    <Path Data="{StaticResource PdfEditorZoomInIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <Button Click="Fit_Click" ToolTip="适合页面" Style="{StaticResource IconButton}" Height="30" Width="30" Margin="4,0,0,0">
                    <Path Data="{StaticResource PdfEditorFitIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
