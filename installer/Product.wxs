<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PDF转换器"
           Manufacturer="DocConvert contributors"
           Version="0.6.0"
           UpgradeCode="8B44B075-8604-4A65-B1E2-A270B11C21EC"
           Scope="perUser">
    <SummaryInformation Description="专业 PDF 转换、OCR 与授权文档去水印工具" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 PDF转换器。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="DocConvertIcon" SourceFile="..\assets\ui\DocConvert.ico" />
    <Property Id="ARPPRODUCTICON" Value="DocConvertIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DocConvert" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuProductFolder" Name="PDF转换器" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="StartMenuShortcut" Directory="ProgramMenuProductFolder" Guid="*">
      <Shortcut Id="StartMenuShortcutLink"
                Name="PDF转换器"
                Description="专业 PDF 转换、OCR 与去水印"
                Target="[INSTALLFOLDER]PDFConverter.exe"
                Icon="DocConvertIcon"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuProductFolder" On="uninstall" />
      <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\DocConvert" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcutLink"
                Name="PDF转换器"
                Description="专业 PDF 转换、OCR 与去水印"
                Target="[INSTALLFOLDER]PDFConverter.exe"
                Icon="DocConvertIcon"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\DocConvert" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="PDF转换器" Level="1" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="PublishFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="DesktopShortcutFeature" Title="桌面快捷方式" Description="在桌面创建 PDF转换器快捷方式" Level="2" AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
